rules_version = '2';
// Premium Studio — Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'abdullra7manx@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Official prices. A player can only add an item at its real price.
    function prices() {
      return {
        'blockfall__demo': 0, 'blockfall__std': 39.99, 'blockfall__gold': 99.99,
        'last-recording__demo': 0, 'last-recording__std': 69.99, 'last-recording__gold': 999999.99
      };
    }
    function codeOf(code) { return get(/databases/$(database)/documents/codes/$(code)).data; }
    function validCode(code, game) {
      return code is string
        && exists(/databases/$(database)/documents/codes/$(code))
        && codeOf(code).active == true
        && (codeOf(code).game == '' || codeOf(code).game == game)
        && (codeOf(code).expires == null || codeOf(code).expires > request.time);
    }
    // PS COIN packs (coins in ten-thousandths: 10000 = 1 PS COIN = $100,000)
    function coinPacks() {
      return {
        'u1': {'coins': 1, 'price': 10}, 'u100': {'coins': 100, 'price': 1000},
        'u1000': {'coins': 1000, 'price': 10000}, 'u10000': {'coins': 10000, 'price': 100000},
        'u100000': {'coins': 100000, 'price': 1000000}
      };
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validPid(pid) { return pid is string && pid.matches('^[0-9]{10}$'); }
    // The pid is reserved for this player in the same write
    function pidReserved(pid) {
      return existsAfter(/databases/$(database)/documents/playerIds/$(pid))
        && getAfter(/databases/$(database)/documents/playerIds/$(pid)).data.uid == request.auth.uid;
    }

    function unameOwner(un) { return get(/databases/$(database)/documents/usernames/$(un)).data.uid; }
    function frAfter(a, b) { return getAfter(/databases/$(database)/documents/users/$(a)/friends/$(b)).data.status; }

    // Usernames: one document per name, so no two accounts share one. Never changes.
    function validUname(un) { return un is string && un.matches('^[a-z0-9_.]{3,20}$'); }
    function unameReserved(un) {
      return existsAfter(/databases/$(database)/documents/usernames/$(un))
        && getAfter(/databases/$(database)/documents/usernames/$(un)).data.uid == request.auth.uid;
    }
    match /usernames/{un} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && validUname(un)
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Account numbers: one document per number, so no two accounts share one. Never changes.
    match /playerIds/{pid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && validPid(pid)
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Player profile
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['pid', 'name', 'email', 'joined', 'coins', 'username'])
        && (!('username' in request.resource.data) || (validUname(request.resource.data.username) && unameReserved(request.resource.data.username)))
        && request.resource.data.coins == 1
        && validPid(request.resource.data.pid) && pidReserved(request.resource.data.pid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.joined == request.time;
      allow update: if isAdmin() || (isMe(uid) && (
          // add a PS ID and/or the signup bonus once, to an older account that has none
          (changed().hasOnly(['pid', 'coins']) && changed().size() > 0
            && (!changed().hasAny(['pid']) || (!('pid' in resource.data) && validPid(request.resource.data.pid) && pidReserved(request.resource.data.pid)))
            && (!changed().hasAny(['coins']) || (!('coins' in resource.data) && request.resource.data.coins == 1)))
          // pick a username once
          || (changed().hasOnly(['username']) && !('username' in resource.data)
            && validUname(request.resource.data.username) && unameReserved(request.resource.data.username))
          // market: the buyer pays for a listing (their coins go down by its price)
          || (changed().hasOnly(['coins', 'lastTrade']) && request.resource.data.lastTrade is string
            && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.buyer == uid
            && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.status == 'open'
            && request.resource.data.coins == resource.data.coins - get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.price
            && request.resource.data.coins >= 0)
          // change the display name only; PS ID and coins stay
          || (changed().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32)
        ));
      // market: the buyer pays the seller in the same write that buys the listing
      allow update: if signedIn() && request.auth.uid != uid
        && changed().hasOnly(['coins', 'lastSale']) && request.resource.data.lastSale is string
        && get(/databases/$(database)/documents/listings/$(request.resource.data.lastSale)).data.status == 'open'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.lastSale)).data.seller == uid
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.lastSale)).data.buyer == request.auth.uid
        && request.resource.data.coins == resource.data.coins + get(/databases/$(database)/documents/listings/$(request.resource.data.lastSale)).data.price;
      allow delete: if isAdmin();

      // Gifts: buy an edition for a friend; the studio confirms the payment and it goes to their library
      match /gifts/{gid2} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['to', 'toName', 'game', 'edition', 'price', 'status', 'at'])
          && request.resource.data.game + '__' + request.resource.data.edition in prices()
          && prices()[request.resource.data.game + '__' + request.resource.data.edition] > 0
          && request.resource.data.price == prices()[request.resource.data.game + '__' + request.resource.data.edition]
          && request.resource.data.status == 'pending' && request.resource.data.at == request.time
          && request.resource.data.to is string && request.resource.data.to != uid
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.resource.data.to))
          && get(/databases/$(database)/documents/users/$(uid)/friends/$(request.resource.data.to)).data.status == 'ok';
        allow update: if isAdmin() && changed().hasOnly(['status', 'sentAt']);
        allow delete: if isAdmin() || (isMe(uid) && resource.data.status == 'pending');
      }

      // Trading cards: one drops for every 30 minutes played, up to 3 per game; also bought on the market
      match /cardDrops/{game} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1 && request.resource.data.n <= 3
          && request.resource.data.n * 30 <= get(/databases/$(database)/documents/users/$(uid)/play/$(game)).data.minutes;
      }
      match /cards/{card} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['game', 'count', 'lastTrade', 'via'])
          && request.resource.data.count is int && request.resource.data.count >= 0 && request.resource.data.game is string
          && card.matches('^' + request.resource.data.game + '_[0-9]$') && (
            // a drop
            (request.resource.data.via == 'drop' && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
              && getAfter(/databases/$(database)/documents/users/$(uid)/cardDrops/$(request.resource.data.game)).data.n == (exists(/databases/$(database)/documents/users/$(uid)/cardDrops/$(request.resource.data.game)) ? get(/databases/$(database)/documents/users/$(uid)/cardDrops/$(request.resource.data.game)).data.n : 0) + 1)
            // put one on the market (it's held by the listing)
            || (request.resource.data.via == 'list' && resource != null && request.resource.data.count == resource.data.count - 1
              && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.seller == uid && !exists(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)))
            // bought one
            || (request.resource.data.via == 'buy' && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
              && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.status == 'open'
              && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.card == card
              && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.buyer == uid)
            // took a listing back
            || (request.resource.data.via == 'cancel' && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
              && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.status == 'open'
              && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.seller == uid
              && get(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.card == card
              && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.lastTrade)).data.status == 'cancelled')
            // used for a badge (one of each card of the set)
            || (request.resource.data.via == 'craft' && resource != null && request.resource.data.count == resource.data.count - 1
              && getAfter(/databases/$(database)/documents/users/$(uid)/badges/$(request.resource.data.game)).data.level == (exists(/databases/$(database)/documents/users/$(uid)/badges/$(request.resource.data.game)) ? get(/databases/$(database)/documents/users/$(uid)/badges/$(request.resource.data.game)).data.level : 0) + 1));
      }
      match /badges/{game} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['level', 'at'])
          && request.resource.data.level == (resource == null ? 0 : resource.data.level) + 1 && request.resource.data.level <= 5
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_1')).data.count == get(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_1')).data.count - 1
          && getAfter(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_2')).data.count == get(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_2')).data.count - 1
          && getAfter(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_3')).data.count == get(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_3')).data.count - 1
          && getAfter(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_4')).data.count == get(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_4')).data.count - 1
          && getAfter(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_5')).data.count == get(/databases/$(database)/documents/users/$(uid)/cards/$(game + '_5')).data.count - 1;
      }

      // PS COIN purchase requests; the studio confirms payment and adds the coins
      match /coinOrders/{oid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['pack', 'coins', 'price', 'status', 'at'])
          && request.resource.data.pack in coinPacks()
          && request.resource.data.coins == coinPacks()[request.resource.data.pack].coins
          && request.resource.data.price == coinPacks()[request.resource.data.pack].price
          && request.resource.data.status == 'pending'
          && request.resource.data.at == request.time;
        allow update: if isAdmin() && changed().hasOnly(['status', 'paidAt']);
        allow delete: if isAdmin();
      }

      // Friends: users/<me>/friends/<them>. Both sides are written in one batch:
      // a request is "out" on the sender and "in" on the receiver; accepting turns both to "ok".
      match /friends/{fid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if signedIn() && fid != uid
          && request.resource.data.keys().hasOnly(['username', 'status', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.username is string
          && unameOwner(request.resource.data.username) == fid
          && ((isMe(uid) && request.resource.data.status == 'out' && frAfter(fid, uid) == 'in')
              || (request.auth.uid == fid && request.resource.data.status == 'in' && frAfter(fid, uid) == 'out'));
        allow update: if signedIn() && changed().hasOnly(['status']) && request.resource.data.status == 'ok'
          && frAfter(fid, uid) == 'ok'
          && ((isMe(uid) && resource.data.status == 'in') || (request.auth.uid == fid && resource.data.status == 'out'));
        allow delete: if isMe(uid) || (signedIn() && request.auth.uid == fid) || isAdmin();
      }

      // Refunds: a paid edition, within 14 days of payment, played under 2 hours. The studio approves.
      match /refunds/{itemId} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['game', 'edition', 'price', 'minutes', 'status', 'at'])
          && request.resource.data.game + '__' + request.resource.data.edition == itemId
          && request.resource.data.status == 'pending' && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/users/$(uid)/library/$(itemId))
          && get(/databases/$(database)/documents/users/$(uid)/library/$(itemId)).data.status == 'paid'
          && get(/databases/$(database)/documents/users/$(uid)/library/$(itemId)).data.paidAt > request.time - duration.value(14, 'd')
          && request.resource.data.price == get(/databases/$(database)/documents/users/$(uid)/library/$(itemId)).data.price
          && (!exists(/databases/$(database)/documents/users/$(uid)/play/$(request.resource.data.game))
              || get(/databases/$(database)/documents/users/$(uid)/play/$(request.resource.data.game)).data.minutes < 120);
        allow update, delete: if isAdmin();
      }

      // Game achievements (a game unlocks them through the Premium Studio app). Once unlocked they stay.
      match /achievements/{aid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['game', 'id', 'at'])
          && request.resource.data.game is string && request.resource.data.id is string
          && aid == request.resource.data.game + '__' + request.resource.data.id
          && aid.size() <= 100 && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Cloud saves: a game's saved data, synced by the Premium Studio app
      match /cloud/{game} {
        allow read, delete: if isMe(uid) || isAdmin();
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['data', 'size', 'at', 'parts', 'v'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.size is int && request.resource.data.at == request.time;
        // big saves (BLOCKFALL worlds) come in gzip parts
        match /parts/{n} {
          allow read, delete: if isMe(uid) || isAdmin();
          allow create, update: if isMe(uid)
            && request.resource.data.keys().hasOnly(['d', 'v'])
            && request.resource.data.d is string && request.resource.data.d.size() <= 800000
            && request.resource.data.v is int;
        }
      }

      // Wishlist and library settings (favorites, hidden)
      match /wishlist/{gid} {
        allow read: if isMe(uid) || isAdmin();
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if isMe(uid);
      }
      match /meta/{d} {
        allow read: if isMe(uid);
        allow write: if isMe(uid) && ((d == 'prefs' && request.resource.data.keys().hasOnly(['fav', 'hidden'])
          && request.resource.data.fav is list && request.resource.data.fav.size() <= 200 && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 200)
          || (d == 'security' && request.resource.data.keys().hasOnly(['signOutBefore']) && request.resource.data.signOutBefore == request.time));
      }
      // the devices you signed in from
      match /devices/{dev} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['name', 'first', 'last'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60 && request.resource.data.last == request.time;
      }

      // Play time per game, written by the Premium Studio app when a game closes
      match /play/{gid} {
        allow read: if isMe(uid) || isAdmin();
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['game', 'minutes', 'last'])
          && request.resource.data.game == gid
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= (resource == null ? 0 : resource.data.minutes)
          && request.resource.data.minutes <= (resource == null ? 0 : resource.data.minutes) + 1440
          && request.resource.data.last == request.time;
        allow delete: if isAdmin();
      }

      // Library: one document per game edition, id = "<game>__<edition>"
      match /library/{itemId} {
        allow read: if isMe(uid) || isAdmin() || inFamilyOf(uid);
        allow create: if isMe(uid)
          && itemId in prices()
          && request.resource.data.game + '__' + request.resource.data.edition == itemId
          && request.resource.data.at == request.time
          && (
            // no code: full price
            (request.resource.data.keys().hasOnly(['game', 'edition', 'price', 'status', 'at'])
              && request.resource.data.price == prices()[itemId]
              && ((prices()[itemId] == 0 && request.resource.data.status == 'free')
                  || (prices()[itemId] > 0 && request.resource.data.status == 'pending')))
            // with a discount code
            || (request.resource.data.keys().hasOnly(['game', 'edition', 'price', 'status', 'at', 'code'])
              && prices()[itemId] > 0
              && validCode(request.resource.data.code, request.resource.data.game)
              && request.resource.data.price == prices()[itemId] * (100 - codeOf(request.resource.data.code).pct) / 100
              && ((request.resource.data.price == 0 && request.resource.data.status == 'granted')
                  || (request.resource.data.price > 0 && request.resource.data.status == 'pending')))
          );
        // the studio can give any edition (also the Developer edition, which isn't sold)
        allow create: if isAdmin()
          && itemId.matches('^[a-z0-9-]+__(demo|std|gold|dev)$')
          && request.resource.data.keys().hasOnly(['game', 'edition', 'price', 'status', 'at', 'from'])
          && request.resource.data.game + '__' + request.resource.data.edition == itemId
          && request.resource.data.status == 'granted' && request.resource.data.price == 0;
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt'])
          && request.resource.data.status in ['paid', 'pending', 'free', 'granted'];
        allow delete: if isAdmin();
      }
    }

    // Download codes for a game's official launcher: only players who own the game can read them
    function ownsEd(g, ed) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__' + ed))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__' + ed)).data.status != 'pending';
    }
    match /keys/{game} {
      allow get: if signedIn() && (ownsEd(game, 'demo') || ownsEd(game, 'std') || ownsEd(game, 'gold') || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // Discount codes: players can check one code by name; only the studio can list or change them
    match /codes/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // ---------------- BLOCKFALL 3001 servers (written by the BLOCKFALL launcher) ----------------
    // A server: owner + team (members map uid -> {name, role, at}), memberIds (for queries), fixed join code,
    // host (who is running it now), world snapshot in /world/{n}. plan/paidUntil are set only by the admin (paid servers later).
    function bfS(sid) { return get(/databases/$(database)/documents/bfServers/$(sid)).data; }
    function bfRole(sid) { return signedIn() && request.auth.uid in bfS(sid).members ? bfS(sid).members[request.auth.uid].role : ''; }
    function bfRoleIn(d) { return signedIn() && request.auth.uid in d.members ? d.members[request.auth.uid].role : ''; }
    match /bfServers/{sid} {
      allow read: if resource.data.public == true
        || (signedIn() && request.auth.uid in resource.data.memberIds) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && request.resource.data.plan == 'free' && request.resource.data.paidUntil == null
        && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{8}$');
      // owner: anything except plan/paidUntil
      allow update: if bfRoleIn(resource.data) == 'owner'
        && !changed().hasAny(['plan', 'paidUntil', 'created'])
        && request.resource.data.owner in request.resource.data.memberIds;
      // admin: settings, team (not the owner), bans, hosting, world
      allow update: if bfRoleIn(resource.data) == 'admin'
        && !changed().hasAny(['plan', 'paidUntil', 'created', 'owner', 'ownerName'])
        && request.resource.data.members[resource.data.owner].role == 'owner'
        && resource.data.owner in request.resource.data.memberIds;
      // mod: start/stop it on their PC, save the world, ban list
      allow update: if bfRoleIn(resource.data) == 'mod'
        && changed().hasOnly(['host', 'worldVer', 'worldSize', 'worldParts', 'updated', 'bans']);
      // any member may leave (remove only themselves)
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && changed().hasOnly(['members', 'memberIds'])
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.members[request.auth.uid].role != 'owner';
      allow update: if isAdmin();
      allow delete: if bfRoleIn(resource.data) == 'owner' || isAdmin();
      match /world/{part} {
        allow read, write: if bfRole(sid) in ['owner', 'admin', 'mod'];
      }
    }

    // Chat between friends: chats/<uidA_uidB>/msgs (ids sorted). Only the two friends read and write.
    function chatPart(cid, i) { return cid.split('_')[i]; }
    function inChat(cid) { return signedIn() && cid.split('_').size() == 2 && chatPart(cid, 0) < chatPart(cid, 1)
      && (request.auth.uid == chatPart(cid, 0) || request.auth.uid == chatPart(cid, 1)); }
    function chatOther(cid) { return request.auth.uid == chatPart(cid, 0) ? chatPart(cid, 1) : chatPart(cid, 0); }
    match /chats/{cid}/msgs/{mid} {
      allow read: if inChat(cid);
      allow create: if inChat(cid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(chatOther(cid)))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(chatOther(cid))).data.status == 'ok'
        && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'kind', 'game'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.kind in ['text', 'invite']
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && (!('game' in request.resource.data) || (request.resource.data.game is string && request.resource.data.game.size() <= 40));
      allow update: if false;
      allow delete: if inChat(cid) && resource.data.from == request.auth.uid;
    }

    // Reviews: only players who own the game; one per player per game
    function ownsAny(g) {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__demo')) && get(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__demo')).data.status != 'pending')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__std')) && get(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__std')).data.status != 'pending')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__gold')) && get(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__gold')).data.status != 'pending')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__dev')) && get(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(g + '__dev')).data.status != 'pending');
    }
    match /reviews/{g}/r/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid) && ownsAny(g)
        && request.resource.data.keys().hasOnly(['username', 'up', 'text', 'hours', 'at'])
        && request.resource.data.up is bool && request.resource.data.text is string && request.resource.data.text.size() <= 800
        && request.resource.data.hours is int && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.at == request.time;
      allow delete: if isMe(uid) || isAdmin();
    }

    // Family sharing: an owner lets up to 5 friends play their games
    function inFamilyOf(owner) { return signedIn() && exists(/databases/$(database)/documents/families/$(owner)) && request.auth.uid in get(/databases/$(database)/documents/families/$(owner)).data.members; }
    match /families/{owner} {
      allow read: if signedIn() && (request.auth.uid == owner || request.auth.uid in resource.data.members);
      allow create, update: if isMe(owner) && request.resource.data.keys().hasOnly(['members', 'names'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 5 && !(owner in request.resource.data.members)
        && request.resource.data.names is map;
      allow delete: if isMe(owner);
    }

    // Market: trading cards for PS COIN. Listing holds the card; buying moves the coins and the card in one write.
    match /listings/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'card', 'game', 'price', 'status', 'at'])
        && request.resource.data.seller == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.at == request.time
        && request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 10000000
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/cards/$(request.resource.data.card)).data.lastTrade == id
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/cards/$(request.resource.data.card)).data.via == 'list';
      allow update: if signedIn() && resource.data.status == 'open' && (
          // buy
          (request.auth.uid != resource.data.seller && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer', 'soldAt'])
            && request.resource.data.status == 'sold' && request.resource.data.buyer == request.auth.uid && request.resource.data.soldAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastTrade == id
            && getAfter(/databases/$(database)/documents/users/$(resource.data.seller)).data.lastSale == id
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/cards/$(resource.data.card)).data.lastTrade == id)
          // take it back
          || (request.auth.uid == resource.data.seller && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/cards/$(resource.data.card)).data.lastTrade == id));
      allow delete: if isAdmin();
    }
    match /{path=**}/gifts/{g} {
      allow read: if isAdmin();
    }

    // Voice calls, parties and Remote Play: only between friends; the handshake messages go to one person each
    function friendOk(x) { return get(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(x)).data.status == 'ok'; }
    function membersOk(m) { return m.size() >= 2 && m.size() <= 6 && m[0] == request.auth.uid && friendOk(m[1])
      && (m.size() < 3 || friendOk(m[2])) && (m.size() < 4 || friendOk(m[3])) && (m.size() < 5 || friendOk(m[4])) && (m.size() < 6 || friendOk(m[5])); }
    match /calls/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['host', 'members', 'names', 'kind', 'game', 'in', 'status', 'at'])
        && request.resource.data.host == request.auth.uid && membersOk(request.resource.data.members)
        && request.resource.data.kind in ['voice', 'party', 'remote'] && request.resource.data.in == [request.auth.uid]
        && request.resource.data.status == 'live' && request.resource.data.at == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.members && changed().hasOnly(['in', 'status'])
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'ended')
        && request.resource.data.in.toSet().difference(resource.data.in.toSet()).hasOnly([request.auth.uid])
        && resource.data.in.toSet().difference(request.resource.data.in.toSet()).hasOnly([request.auth.uid]);
      match /sig/{m} {
        allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['from', 'to', 'type', 'data', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.type in ['offer', 'answer', 'ice']
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(id)).data.members && request.resource.data.to in get(/databases/$(database)/documents/calls/$(id)).data.members
          && request.resource.data.data is string && request.resource.data.data.size() <= 20000;
      }
    }

    // Workshop: worlds shared by players (the app uploads them in parts)
    match /workshop/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['game', 'author', 'authorName', 'title', 'desc', 'mode', 'parts', 'size', 'subs', 'at'])
        && request.resource.data.author == request.auth.uid && request.resource.data.subs == 0 && request.resource.data.at == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 60 && request.resource.data.desc is string && request.resource.data.desc.size() <= 600
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 12;
      allow update: if signedIn() && changed().hasOnly(['subs']) && request.resource.data.subs == resource.data.subs + 1;
      allow delete: if signedIn() && (resource.data.author == request.auth.uid || isAdmin());
      match /parts/{n} {
        allow read: if signedIn();
        allow create: if signedIn() && getAfter(/databases/$(database)/documents/workshop/$(id)).data.author == request.auth.uid
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 800000;
        allow delete: if signedIn() && get(/databases/$(database)/documents/workshop/$(id)).data.author == request.auth.uid;
      }
    }

    // Public profile card (level, badges) that friends see
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'level', 'xp', 'hours', 'badges', 'at'])
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.level is int && request.resource.data.xp is int && request.resource.data.hours is int
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 30
        && request.resource.data.at == request.time;
    }

    // What each player is playing right now (friends see it). Written by the Premium Studio app.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['game', 'gid', 'at', 'state'])
        && (!('state' in request.resource.data) || request.resource.data.state in ['online', 'away', 'invisible'])
        && (!('game' in request.resource.data) || (request.resource.data.game is string && request.resource.data.gid is string))
        && (!('game' in request.resource.data) || (request.resource.data.game.size() <= 60 && request.resource.data.gid.size() <= 40))
        && request.resource.data.at == request.time;
    }

    match /{path=**}/refunds/{rid} {
      allow read: if isAdmin();
    }

    match /{path=**}/coinOrders/{oid} {
      allow read: if isAdmin();
    }

    // Studio dashboard reads every library across players
    match /{path=**}/library/{itemId} {
      allow read: if isAdmin();
    }
  }
}
